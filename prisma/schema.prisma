generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  price         Int
  discountPrice Int?
  imageUrls     String
  badges        String   @default("[]")
  color         String
  category      String
  section       String   @default("men")
  stockS        Int      @default(10)
  stockM        Int      @default(10)
  stockL        Int      @default(10)
  stockXL       Int      @default(10)
  isVisible     Boolean  @default(true)
  rating        Float    @default(4.5)
  reviewCount   Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([isVisible, section, createdAt(sort: Desc)])
  @@index([section, isVisible])
  @@index([category])
}

model SiteSettings {
  id          String @id
  bgPrimary   String
  accentColor String
  bannerBg    String
  bannerText  String
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  subtotal        Int
  discountAmount  Int         @default(0)
  shippingFee     Int         @default(0)
  totalAmount     Int
  couponCode      String?
  status          String      @default("PAID")
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())

  @@index([orderNumber])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  slug      String
  size      String
  price     Int
  qty       Int
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
