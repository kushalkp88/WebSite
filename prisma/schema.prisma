generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  price         Int
  discountPrice Int?
  imageUrls     String
  badges        String   @default("[]")
  color         String
  category      String
  section       String   @default("men")
  stockS        Int      @default(10)
  stockM        Int      @default(10)
  stockL        Int      @default(10)
  stockXL       Int      @default(10)
  isVisible     Boolean  @default(true)
  rating        Float    @default(4.5)
  reviewCount   Int      @default(0)
  createdAt     DateTime @default(now())
}

model SiteSettings {
  id          String @id
  bgPrimary   String
  accentColor String
  bannerBg    String
  bannerText  String
}
